{
  "manifest_version": 3,
  "name": "SIR Reader",
  "version": "0.9.0",
  "description": "Lee las conversaciones de la sesión ya abierta. En WhatsApp lee el Store interno (wa-js) y hace backfill solo; en el resto, lo renderizado. Nunca envía mensajes ni abre historias.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.cloud.microsoft/*",
    "https://web.whatsapp.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://www.instagram.com/*",
    "https://www.linkedin.com/*",
    "https://sir-v2-life-os.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SIR Reader" },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["content/common.js", "content/teams.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/common.js", "content/whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/wppconnect-wa.js", "content/waStoreReader.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content/common.js", "content/outlook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/socialBridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/instagramReader.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/socialBridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/linkedinReader.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
