# Repo PÚBLICO: data/ trae datos reales de personas (batches, exports).
# NUNCA subir nada de data/ salvo la documentación versionada (README).
# Patrón "ignorá el contenido del dir excepto un archivo": el dir se re-incluye
# para poder re-incluir el README adentro.
/data/*
!/data/seed-batches
/data/seed-batches/*
!/data/seed-batches/README.md

# Python bytecode (scripts/generate_roadmap.py + futuros scripts)
__pycache__/
*.pyc

.vercel
.claude/

# Playwright e2e (issue #819)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/
# Excel de identidades: contiene nombres, teléfonos y correos reales de la red
# de Aaron. Se genera con scripts/identidades-export.mjs y NO se versiona.
identidades*.xlsx

# Scratch de verificación (zz*). El patrón era por extensión (.mjs/.jpg/.xlsx) y
# dejaba pasar todo lo demás: un zz-vec.json y una carpeta zzexport/ con un export
# real de WhatsApp —mensajes de Aaron y de Diana— aparecieron como archivos sin
# seguimiento, a un `git add -A` de quedar versionados. Ahora se ignora TODO lo que
# empiece con zz, que es la regla que uno cree que ya existía.
zz*
!zz*.ts
!zz*.tsx
